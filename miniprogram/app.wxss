/* 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: #333333;
  background: #f5f5f5;
  font-size: 28rpx;
  line-height: 1.8;
}

/* 通用工具类 */
.container {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04);
}

/* 标题色 */
.c-primary { color: #c41e3a; }
.c-sub { color: #666666; }
.c-muted { color: #999999; }

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}
.tag-red {
  background: #fef0f0;
  color: #c41e3a;
  border: 1rpx solid #fdd;
}
.tag-blue {
  background: #eef4ff;
  color: #3a6bc4;
  border: 1rpx solid #dde8ff;
}
.tag-green {
  background: #f0faf0;
  color: #2a8a3a;
  border: 1rpx solid #ddf0dd;
}

/* 加载态 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}
.loading-wrap .icon { font-size: 60rpx; margin-bottom: 20rpx; }
.loading-wrap .text { color: #999; font-size: 26rpx; }

/* 空态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}
.empty-wrap .icon { font-size: 80rpx; margin-bottom: 20rpx; opacity: 0.4; }
.empty-wrap .text { color: #999; font-size: 28rpx; }
