<view class="page">
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="icon">⏳</view>
    <view class="text">正在读取历史文章…</view>
  </view>

  <view class="article" wx:if="{{!loading && article}}">
    <view class="position">{{issueTitle || date}} · 第 {{currentIndex + 1}} / {{total}} 篇</view>
    <view class="column">{{article.column || (source === 'qiushi' ? '《求是》' : '人民网观点')}}</view>
    <view class="title">{{article.title}}</view>
    <view class="meta">{{article.publishDate || date}}<text wx:if="{{article.source}}"> · {{article.source}}</text><text wx:if="{{article.author}}"> · {{article.author}}</text></view>
    <view class="body">
      <text class="paragraph" user-select="true" wx:for="{{article.paragraphs}}" wx:key="*this">{{item}}</text>
      <text class="content" user-select="true" wx:if="{{(!article.paragraphs || !article.paragraphs.length) && article.content}}">{{article.content}}</text>
    </view>
    <view class="source" bindtap="onCopyUrl">原文链接：{{article.url}}</view>
    <view class="nav-row">
      <view class="nav-btn {{!hasPrevious ? 'disabled' : ''}}" bindtap="onPrevious">上一篇</view>
      <view class="nav-btn primary {{!hasNext ? 'disabled' : ''}}" bindtap="onNext">下一篇</view>
    </view>
  </view>

  <view class="empty-wrap" wx:if="{{!loading && !article}}">
    <view class="icon">📄</view>
    <view class="text">文章读取失败</view>
    <view class="error">{{error}}</view>
  </view>
</view>
