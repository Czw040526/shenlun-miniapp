.page { min-height: 100vh; padding: 24rpx 22rpx calc(48rpx + env(safe-area-inset-bottom)); background: #f4f1eb; }
.article { padding: 34rpx 32rpx; border-radius: 14rpx; background: #fffdf9; box-shadow: 0 6rpx 26rpx rgba(73, 55, 37, 0.07); }
.position { margin-bottom: 20rpx; color: #8c8379; font-size: 21rpx; }
.column { color: #a92c36; font-size: 23rpx; font-weight: 700; letter-spacing: 2rpx; }
.title { margin-top: 12rpx; color: #211e1a; font-size: 40rpx; font-weight: 700; line-height: 1.45; }
.meta { margin-top: 16rpx; color: #8c8379; font-size: 22rpx; }
.body { margin-top: 32rpx; padding-top: 30rpx; border-top: 1rpx solid #eee7de; }
.paragraph { display: block; margin-bottom: 26rpx; color: #292622; font-size: 31rpx; line-height: 2; text-align: justify; }
.content { display: block; color: #292622; font-size: 31rpx; line-height: 2; white-space: pre-wrap; }
.source { padding: 20rpx 0; border-top: 1rpx solid #eee7de; color: #365f8d; font-size: 21rpx; line-height: 1.55; word-break: break-all; }
.nav-row { display: flex; gap: 20rpx; margin-top: 20rpx; }
.nav-btn { flex: 1; min-height: 72rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #c8beb2; border-radius: 10rpx; color: #514940; font-size: 27rpx; font-weight: 600; }
.nav-btn.primary { border-color: #a92c36; background: #a92c36; color: #fff; }
.nav-btn.disabled { opacity: 0.32; }
.error { margin-top: 12rpx; color: #999; font-size: 22rpx; text-align: center; }
