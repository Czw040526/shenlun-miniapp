/* 历史记录页样式 */

.page {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
  background: #f4f5f7;
}

.container {
  padding: 20rpx 24rpx 32rpx;
}

/* 记录卡片 */
.record-item {
  margin-bottom: 22rpx;
}

.record-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #e1e1e1;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.035);
}
.record-item.is-expanded .record-header { border-bottom-color: #ededed; }
.record-date {
  width: 80rpx;
  text-align: center;
  flex-shrink: 0;
}
.record-date .day {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.2;
}
.record-date .month {
  font-size: 22rpx;
  color: #999;
}

.record-summary {
  flex: 1;
  min-width: 0;
}
.record-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.record-counts {
  display: flex;
  gap: 20rpx;
}
.count-item {
  font-size: 22rpx;
  color: #888;
}

.expand-icon {
  font-size: 36rpx;
  color: #ccc;
  transition: transform 0.2s ease;
  flex-shrink: 0;
}
.expand-icon.rotated {
  transform: rotate(90deg);
}

/* 展开内容 */
.record-body {
  padding-top: 18rpx;
}
.history-detail-loading {
  padding: 16rpx 0;
  color: #888;
  font-size: 22rpx;
  text-align: center;
}

.history-copy-row {
  display: flex;
  justify-content: flex-end;
}
.history-copy-btn {
  min-height: 56rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6rpx;
  background: #c41e3a;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}
.history-modules {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.history-module {
  overflow: hidden;
  border: 1rpx solid #dedede;
  border-left-width: 6rpx;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.03);
}
.history-module-header {
  position: relative;
  min-height: 78rpx;
  padding: 18rpx 212rpx 14rpx 17rpx;
  display: flex;
  align-items: flex-start;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  background: #fff;
}
.history-module-heading {
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.history-module-code {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 6rpx;
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
}
.history-module-label {
  color: #888;
  font-size: 18rpx;
  line-height: 1.2;
}
.history-module-title {
  color: #333;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.35;
}
.history-module-actions {
  position: absolute;
  top: 11rpx;
  right: 12rpx;
  display: flex;
  align-items: center;
  gap: 7rpx;
}
.history-module-copy {
  min-height: 44rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  flex-shrink: 0;
  border: 1rpx solid currentColor;
  border-radius: 6rpx;
  background: #fff;
  color: #666;
  font-size: 19rpx;
}
.history-module-copy.secondary {
  color: #1f5d94;
}
.history-module-body {
  padding: 16rpx 18rpx 20rpx;
}
.history-content-line {
  display: block;
  color: #333;
  font-size: 22rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}
.history-line-spacer { height: 10rpx; }
.history-content-line.line-source {
  margin-bottom: 5rpx;
  color: #777;
  font-size: 20rpx;
}
.history-content-line.line-article {
  margin: 6rpx 0 8rpx;
  color: #171719;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.5;
}
.history-content-line.line-heading {
  margin-top: 15rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #ededed;
  color: #252527;
  font-weight: 700;
}
.history-content-line.line-field { margin: 2rpx 0; }
.history-content-line .field-label {
  color: #444;
  font-weight: 700;
}
.history-content-line.line-checklist {
  margin: 7rpx 0;
  padding: 8rpx 10rpx;
  border-radius: 4rpx;
  background: #f5f6f7;
  color: #555;
}
.history-content-line.line-url {
  margin: 8rpx 0 12rpx;
  padding: 9rpx 11rpx 10rpx;
  border-left: 4rpx solid #4f769b;
  border-radius: 4rpx;
  background: #f4f7fa;
}
.history-content-line .url-prefix {
  display: block;
  color: #666;
  font-size: 19rpx;
  font-weight: 600;
}
.history-url-hit {
  display: block;
  padding-top: 3rpx;
}
.history-url {
  color: #1f5d94;
  text-decoration: underline;
  word-break: break-all;
}
.history-module.module-selection { border-left-color: #c41e3a; }
.history-module.module-selection .history-module-code { background: #c41e3a; }
.history-module.module-framework { border-left-color: #3a6bc4; }
.history-module.module-framework .history-module-code { background: #3a6bc4; }
.history-module.module-toolbox { border-left-color: #2a8a3a; }
.history-module.module-toolbox .history-module-code { background: #2a8a3a; }
.history-module.module-argument { border-left-color: #3a6bc4; }
.history-module.module-argument .history-module-code { background: #3a6bc4; }
.history-module.module-method { border-left-color: #2a8a3a; }
.history-module.module-method .history-module-code { background: #2a8a3a; }
.history-module.module-expression { border-left-color: #7b5bbd; }
.history-module.module-expression .history-module-code { background: #7b5bbd; }
.history-module.module-practice { border-left-color: #d69a1f; }
.history-module.module-practice .history-module-code { background: #d69a1f; }
.history-module.module-tier1 { border-left-color: #c41e3a; }
.history-module.module-tier1 .history-module-code { background: #c41e3a; }
.history-module.module-tier2 { border-left-color: #3a6bc4; }
.history-module.module-tier2 .history-module-code { background: #3a6bc4; }
.history-module.module-tier3 { border-left-color: #2a8a3a; }
.history-module.module-tier3 .history-module-code { background: #2a8a3a; }
.history-module.module-avoid { border-left-color: #666; }
.history-module.module-avoid .history-module-code { background: #666; }
.history-module.module-top3 { border-left-color: #d69a1f; }
.history-module.module-top3 .history-module-code { background: #d69a1f; }
