.page { min-height: 100vh; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); background: #f4f1eb; }
.history-head { padding: 30rpx 28rpx 24rpx; background: #fffdf9; border-bottom: 1rpx solid #e8e1d8; }
.head-title { color: #211e1a; font-size: 36rpx; font-weight: 700; }
.head-subtitle { margin-top: 5rpx; color: #8c8379; font-size: 22rpx; }
.records { padding: 22rpx; }
.record { display: flex; align-items: flex-start; gap: 18rpx; margin-bottom: 24rpx; }
.record-date { width: 82rpx; flex-shrink: 0; padding-top: 12rpx; text-align: center; }
.date-day { color: #a92c36; font-size: 42rpx; font-weight: 700; line-height: 1.1; }
.date-month { margin-top: 4rpx; color: #8c8379; font-size: 21rpx; }
.record-main { flex: 1; min-width: 0; overflow: hidden; border: 1rpx solid #e6ded4; border-radius: 12rpx; background: #fffdf9; box-shadow: 0 4rpx 18rpx rgba(73, 55, 37, 0.05); }
.record-title { padding: 22rpx 22rpx 3rpx; color: #2c2925; font-size: 28rpx; font-weight: 700; }
.record-count { padding: 0 22rpx 16rpx; color: #8c8379; font-size: 21rpx; }
.article-row { display: flex; align-items: center; gap: 14rpx; min-height: 86rpx; padding: 12rpx 18rpx; border-top: 1rpx solid #eee7de; }
.article-row:active { background: #f8f3ec; }
.article-index { width: 38rpx; height: 38rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f4e8e8; color: #a92c36; font-size: 20rpx; font-weight: 700; }
.article-info { flex: 1; min-width: 0; }
.article-title { color: #332f2a; font-size: 25rpx; font-weight: 600; line-height: 1.45; }
.article-column { margin-top: 3rpx; color: #988e83; font-size: 20rpx; }
.article-arrow { color: #b7aea4; font-size: 36rpx; }
.empty-message { margin-top: 12rpx; color: #999; font-size: 22rpx; text-align: center; }
