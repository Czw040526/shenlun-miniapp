<view class="page">
  <view class="reader-bar">
    <view>
      <view class="reader-date">{{dateText}}</view>
      <view class="reader-count" wx:if="{{total}}">第 {{currentIndex + 1}} 篇 / 共 {{total}} 篇</view>
    </view>
    <view class="refresh-btn" bindtap="onRefresh">刷新文章</view>
  </view>

  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="icon">⏳</view>
    <view class="text">正在从云端读取并归档文章…</view>
  </view>

  <view class="article-wrap" wx:if="{{!loading && article}}">
    <view class="article-head">
      <view class="article-column">{{article.column || '人民网观点'}}</view>
      <view class="article-title">{{article.title}}</view>
      <view class="article-meta">
        <text>{{article.publishDate || dateText}}</text>
        <text wx:if="{{article.source}}"> · {{article.source}}</text>
        <text wx:if="{{article.author}}"> · {{article.author}}</text>
      </view>
    </view>

    <view class="article-body">
      <block wx:for="{{article.paragraphs}}" wx:key="*this">
        <text class="article-paragraph" user-select="true">{{item}}</text>
      </block>
      <text class="article-content" user-select="true" wx:if="{{(!article.paragraphs || !article.paragraphs.length) && article.content}}">{{article.content}}</text>
    </view>

    <view class="article-source" bindtap="onCopyUrl">
      <view class="source-label">原文链接（点击复制）</view>
      <view class="source-url">{{article.url}}</view>
    </view>

    <view class="nav-row">
      <view class="nav-btn {{!hasPrevious ? 'disabled' : ''}}" bindtap="onPrevious">上一篇</view>
      <view class="nav-position">{{currentIndex + 1}} / {{total}}</view>
      <view class="nav-btn primary {{!hasNext ? 'disabled' : ''}}" bindtap="onNext">下一篇</view>
    </view>

    <view class="copyright-note">文章版权归原作者及人民网所有，本小程序仅作个人阅读与归档。</view>
  </view>

  <view class="empty-wrap" wx:if="{{!loading && !article}}">
    <view class="icon">📭</view>
    <view class="text">今天暂时没有文章</view>
    <view class="empty-message">{{error}}</view>
    <view class="empty-refresh" bindtap="onRefresh">重新抓取</view>
  </view>
</view>
