/* 首页样式 */

.page {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
  background: #f4f5f7;
}
.container {
  padding: 0;
}

/* 头部 */
.header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e8e8e8;
  position: sticky;
  top: 0;
  z-index: 10;
}
.date-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.refresh-btn {
  font-size: 26rpx;
  color: #c41e3a;
  min-height: 52rpx;
  padding: 0 18rpx;
  border: 1rpx solid #c41e3a;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

/* 今日学习概览 */
.overview-band {
  padding: 26rpx 28rpx 28rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e8e8e8;
}
.overview-kicker {
  margin-bottom: 6rpx;
  color: #c41e3a;
  font-size: 21rpx;
  font-weight: 700;
}
.overview-band .title {
  color: #202124;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.45;
  word-break: break-word;
}
.overview-band .meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #777;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

/* 分区卡片 */
.section {
  margin: 28rpx 24rpx 32rpx;
}
.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.section-header .badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
}
.tier-1 .badge { background: #c41e3a; }
.tier-2 .badge { background: #3a6bc4; }
.tier-3 .badge { background: #2a8a3a; }
.highlight .badge { background: #e8a838; }

.section-header .label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

/* 文章卡片 */
.article-card {
  position: relative;
  padding: 28rpx 56rpx 28rpx 28rpx;
  margin-bottom: 16rpx;
  border-radius: 14rpx;
}
.article-card:active {
  background: #fafafa;
}
.compact {
  padding: 22rpx 56rpx 22rpx 22rpx;
}
.article-tag-row {
  margin-bottom: 10rpx;
  display: flex;
  flex-wrap: wrap;
}
.article-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.5;
  margin-bottom: 8rpx;
}
.article-excerpt {
  font-size: 24rpx;
  color: #888;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.article-arrow {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #ccc;
  font-size: 32rpx;
}

/* 成品稿 */
.copy-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}
.copy-title {
  color: #202124;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}
.copy-subtitle {
  margin-top: 3rpx;
  color: #8a8a8a;
  font-size: 21rpx;
  line-height: 1.3;
}
.copy-all-btn {
  min-height: 56rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6rpx;
  background: #c41e3a;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}
.material-modules {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}
.material-module {
  overflow: hidden;
  border: 1rpx solid #dedede;
  border-left-width: 6rpx;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.035);
}
.material-module-header {
  position: relative;
  min-height: 86rpx;
  padding: 20rpx 232rpx 17rpx 20rpx;
  display: flex;
  align-items: flex-start;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  background: #fff;
}
.module-heading-group {
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}
.module-code {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 6rpx;
  color: #fff;
  font-size: 21rpx;
  font-weight: 700;
}
.module-heading-text {
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.module-label {
  color: #777;
  font-size: 19rpx;
  line-height: 1.25;
}
.module-title {
  color: #222;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}
.module-actions {
  position: absolute;
  top: 12rpx;
  right: 14rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.module-copy-action {
  min-height: 50rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid currentColor;
  border-radius: 6rpx;
  background: #fff;
  color: #4d4d4d;
  font-size: 21rpx;
  font-weight: 600;
}
.module-copy-action.secondary {
  color: #1f5d94;
}
.module-copy-action:active { opacity: 0.65; }
.material-module-body {
  padding: 20rpx 22rpx 24rpx;
}
.module-content-line {
  display: block;
  color: #303033;
  font-size: 24rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}
.module-line-spacer { height: 13rpx; }
.line-source {
  margin-bottom: 6rpx;
  color: #777;
  font-size: 22rpx;
}
.line-article {
  margin: 7rpx 0 9rpx;
  color: #171719;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.52;
}
.line-heading {
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #ededed;
  color: #252527;
  font-weight: 700;
}
.line-field {
  margin: 3rpx 0;
}
.field-label {
  color: #444;
  font-weight: 700;
}
.line-checklist {
  margin: 8rpx 0;
  padding: 9rpx 12rpx;
  border-radius: 4rpx;
  background: #f5f6f7;
  color: #555;
}
.line-url {
  margin: 10rpx 0 14rpx;
  padding: 11rpx 13rpx 12rpx;
  border-left: 4rpx solid #4f769b;
  border-radius: 4rpx;
  background: #f4f7fa;
}
.url-prefix {
  display: block;
  color: #666;
  font-size: 21rpx;
  font-weight: 600;
}
.module-url-hit {
  display: block;
  padding-top: 3rpx;
}
.module-url {
  color: #1f5d94;
  text-decoration: underline;
  word-break: break-all;
}
.module-url:active { color: #c41e3a; }
.material-module.module-selection { border-left-color: #c41e3a; }
.material-module.module-selection .module-code { background: #c41e3a; }
.material-module.module-framework { border-left-color: #3a6bc4; }
.material-module.module-framework .module-code { background: #3a6bc4; }
.material-module.module-toolbox { border-left-color: #2a8a3a; }
.material-module.module-toolbox .module-code { background: #2a8a3a; }
.material-module.module-argument { border-left-color: #3a6bc4; }
.material-module.module-argument .module-code { background: #3a6bc4; }
.material-module.module-method { border-left-color: #2a8a3a; }
.material-module.module-method .module-code { background: #2a8a3a; }
.material-module.module-expression { border-left-color: #7b5bbd; }
.material-module.module-expression .module-code { background: #7b5bbd; }
.material-module.module-practice { border-left-color: #d69a1f; }
.material-module.module-practice .module-code { background: #d69a1f; }
.material-module.module-tier1 { border-left-color: #c41e3a; }
.material-module.module-tier1 .module-code { background: #c41e3a; }
.material-module.module-tier2 { border-left-color: #3a6bc4; }
.material-module.module-tier2 .module-code { background: #3a6bc4; }
.material-module.module-tier3 { border-left-color: #2a8a3a; }
.material-module.module-tier3 .module-code { background: #2a8a3a; }
.material-module.module-avoid { border-left-color: #666; }
.material-module.module-avoid .module-code { background: #666; }
.material-module.module-top3 { border-left-color: #d69a1f; }
.material-module.module-top3 .module-code { background: #d69a1f; }

/* 金句卡片 */
.quotes-card {
  padding: 28rpx;
}
.quote-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.quote-item:last-child {
  border-bottom: none;
}
.quote-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  font-style: italic;
}
.quote-text::before { content: "\201C"; }
.quote-text::after { content: "\201D"; }
.copy-btn {
  font-size: 22rpx;
  color: #c41e3a;
  padding: 6rpx 16rpx;
  border: 1rpx solid #fdd;
  border-radius: 6rpx;
  flex-shrink: 0;
}

/* 底部 */
.footer-note {
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  padding: 24rpx 0 48rpx;
}
.empty-wrap .sub-text {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 8rpx;
}
