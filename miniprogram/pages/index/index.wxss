.page {
  min-height: 100vh;
  background: #f4f1eb;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.reader-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 28rpx;
  border-bottom: 1rpx solid #e8e1d8;
  background: rgba(255, 253, 249, 0.96);
}

.reader-date { font-size: 28rpx; font-weight: 700; color: #2c2925; }
.reader-count { margin-top: 2rpx; font-size: 21rpx; color: #8c8379; }
.refresh-btn {
  padding: 10rpx 18rpx;
  border: 1rpx solid #a92c36;
  border-radius: 999rpx;
  color: #a92c36;
  font-size: 23rpx;
}

.article-wrap { margin: 22rpx; overflow: hidden; border-radius: 14rpx; background: #fffdf9; box-shadow: 0 6rpx 26rpx rgba(73, 55, 37, 0.07); }
.article-head { padding: 34rpx 32rpx 28rpx; border-bottom: 1rpx solid #eee7de; }
.article-column { margin-bottom: 12rpx; color: #a92c36; font-size: 23rpx; font-weight: 700; letter-spacing: 2rpx; }
.article-title { color: #211e1a; font-size: 40rpx; font-weight: 700; line-height: 1.45; }
.article-meta { margin-top: 18rpx; color: #8c8379; font-size: 22rpx; line-height: 1.6; }
.article-body { padding: 34rpx 32rpx 22rpx; }
.article-paragraph {
  display: block;
  margin-bottom: 26rpx;
  color: #292622;
  font-size: 31rpx;
  line-height: 2;
  text-align: justify;
}
.article-content { display: block; color: #292622; font-size: 31rpx; line-height: 2; white-space: pre-wrap; }
.article-source { margin: 0 32rpx; padding: 22rpx 0; border-top: 1rpx solid #eee7de; }
.source-label { color: #7f756b; font-size: 21rpx; }
.source-url { margin-top: 6rpx; color: #365f8d; font-size: 21rpx; line-height: 1.55; word-break: break-all; }
.nav-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 28rpx 32rpx 34rpx; }
.nav-btn { flex: 1; min-height: 72rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #c8beb2; border-radius: 10rpx; color: #514940; font-size: 27rpx; font-weight: 600; }
.nav-btn.primary { border-color: #a92c36; background: #a92c36; color: #fff; }
.nav-btn.disabled { opacity: 0.32; }
.nav-position { color: #8c8379; font-size: 22rpx; }
.copyright-note { padding: 0 32rpx 34rpx; color: #aaa197; font-size: 20rpx; line-height: 1.6; text-align: center; }
.empty-message { max-width: 600rpx; margin-top: 12rpx; padding: 0 30rpx; color: #999; font-size: 23rpx; text-align: center; }
.empty-refresh { margin-top: 26rpx; padding: 12rpx 26rpx; border-radius: 999rpx; background: #a92c36; color: #fff; font-size: 24rpx; }
