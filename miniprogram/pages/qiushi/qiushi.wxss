.page { min-height: 100vh; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); background: #f2eee7; }
.masthead { padding: 34rpx 30rpx 28rpx; background: #9e1f28; color: #fff; }
.masthead-top { display: flex; align-items: flex-start; justify-content: space-between; }
.magazine-name { font-family: serif; font-size: 54rpx; font-weight: 800; letter-spacing: 16rpx; line-height: 1.1; }
.magazine-en { margin-top: 7rpx; font-size: 17rpx; letter-spacing: 5rpx; opacity: 0.72; }
.schedule { margin-top: 24rpx; font-size: 23rpx; letter-spacing: 2rpx; opacity: 0.9; }
.refresh-btn { padding: 9rpx 17rpx; border: 1rpx solid rgba(255,255,255,.65); border-radius: 999rpx; font-size: 22rpx; }
.pending { margin: 20rpx 22rpx 0; padding: 16rpx 20rpx; border-radius: 10rpx; background: #fff3d7; color: #806022; font-size: 22rpx; line-height: 1.5; }
.issue-card { margin: 22rpx; padding: 28rpx; border: 1rpx solid #e5d9cd; border-radius: 14rpx; background: #fffdf9; box-shadow: 0 6rpx 24rpx rgba(73,55,37,.07); }
.issue-label { display: inline-block; padding: 4rpx 13rpx; border-radius: 6rpx; background: #f3e4e4; color: #9e1f28; font-size: 20rpx; }
.issue-title { margin-top: 15rpx; color: #211e1a; font-size: 36rpx; font-weight: 700; line-height: 1.4; }
.issue-meta { margin-top: 10rpx; color: #6f665d; font-size: 23rpx; }
.issue-source { margin-top: 6rpx; color: #9a9086; font-size: 20rpx; }
.catalog-title { padding: 4rpx 28rpx 13rpx; color: #332e29; font-size: 28rpx; font-weight: 700; }
.article-list { margin: 0 22rpx; overflow: hidden; border: 1rpx solid #e5ddd4; border-radius: 12rpx; background: #fffdf9; }
.article-row { display: flex; align-items: center; gap: 15rpx; min-height: 96rpx; padding: 15rpx 18rpx; border-top: 1rpx solid #eee7de; }
.article-row:first-child { border-top: 0; }
.article-row:active { background: #f8f2eb; }
.article-index { width: 40rpx; height: 40rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f2e4e4; color: #9e1f28; font-size: 19rpx; font-weight: 700; }
.article-info { flex: 1; min-width: 0; }
.article-title { color: #302c28; font-size: 26rpx; font-weight: 600; line-height: 1.5; }
.article-author { margin-top: 3rpx; color: #938980; font-size: 20rpx; }
.article-arrow { color: #b6ada4; font-size: 38rpx; }
.copyright-note { padding: 30rpx 38rpx 0; color: #a69c92; font-size: 20rpx; line-height: 1.6; text-align: center; }
.empty-message { max-width: 620rpx; margin-top: 12rpx; padding: 0 30rpx; color: #999; font-size: 22rpx; text-align: center; }
.empty-refresh { margin-top: 24rpx; padding: 11rpx 24rpx; border-radius: 999rpx; background: #9e1f28; color: #fff; font-size: 23rpx; }
