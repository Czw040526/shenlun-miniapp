# 复制为 web-admin/.env 后填写

# 本地后台端口
PORT=8787

# DeepSeek API Key。后台生成成品稿时使用。
DEEPSEEK_API_KEY=

# 是否开启 7:30 自动生成。1=开启，0=关闭。
AUTO_GENERATE=1

# publishMaterial 云函数的 HTTP 访问地址。
# 未配置时，点击“发布到小程序”会先保存 web-admin/output/YYYY-MM-DD-publish.json。
PUBLISH_FUNCTION_URL=

# 与 publishMaterial 云函数环境变量保持一致，用于防止外部乱发。
PUBLISH_ADMIN_SECRET=
